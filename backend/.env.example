DATABASE_PATH=runtime/stylematch.sqlite3
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Choose a currently available model that supports images, JSON schema, and function calling.
GEMINI_API_KEY=
GEMINI_MODEL=
SERPAPI_API_KEY=
FASHN_API_KEY=
MAX_TRYONS_PER_HOUR=5
SESSION_DAYS=7
# Free local agent (Ollama must be running on the backend machine).
LLM_PROVIDER=ollama
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Set to an installed model with vision capability; leave blank to disable image analysis.
OLLAMA_VISION_MODEL=gemma3:4b
